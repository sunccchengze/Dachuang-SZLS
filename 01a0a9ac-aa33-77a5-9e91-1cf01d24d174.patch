+            "uOld": out["crossSection"]["uOld"],
+        },
+    }) + " as const\n")
+    with open(OUT_TS, "w") as f:
+        f.write("\n".join(ts))
+    print("wrote", OUT_TS, os.path.getsize(OUT_TS), "bytes")
+
+
+if __name__ == "__main__":
+    main()
