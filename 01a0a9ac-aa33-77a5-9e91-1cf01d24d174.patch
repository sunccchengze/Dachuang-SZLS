+    out["deflection"] = defl
+
+    # ---- 6) 下游横截面 u（双机, 涡轮在原点, 节点=floris3dData.mjs 资产网格）----
+    # 资产系 x 以"涡轮上游 200m"为 0（T07 在资产 x=200, T04 在 x=832）
