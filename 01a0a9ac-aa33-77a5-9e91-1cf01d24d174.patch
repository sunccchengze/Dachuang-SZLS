+    import re as _re
+
+    with open(os.path.join(REPO, "twin", "src", "data", "floris3dData.mjs")) as f:
+        _mjs = f.read()
+    _m = _re.search(r"export default (\{.*\})\s*$", _mjs, _re.S)
+    _asset = json.loads(_m.group(1))
