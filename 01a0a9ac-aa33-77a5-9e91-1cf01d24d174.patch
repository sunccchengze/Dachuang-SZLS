+                           "unified30Kw": out["array"]["round18_ref"]["unified+30_kW"]},
+        },
+        "deflection": [
+            {"yaw": d["yaw"], "xD": d["xD"], "centroidYm": d["centroid_y_m"]} for d in out["deflection"]
+        ],
+        "crossSection": {
